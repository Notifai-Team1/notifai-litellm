# Variables del .env de LiteLLM en el EC2 de dev.
# El archivo real es /opt/notifai/litellm/.env, con modo 600, y lo crea un
# humano. Aquí van solo los nombres: ningún valor se versiona.
NOTIFAI_BIND_ADDR=
LITELLM_PORT=
DATABASE_URL=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
